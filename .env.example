# Salin ke .env untuk lokal, atau isi di Coolify → Environment Variables
NODE_ENV=production
PORT=3000
DATA_DIR=/data                      # persistent storage (mount volume di Coolify)
SESSION_SECRET=ganti-dengan-string-acak-panjang
SESSION_TTL_HOURS=24
ADMIN_EMAIL=it.admin@samudraretail.co.id   # admin pertama (dibuat sekali saat DB kosong)
ADMIN_PASSWORD=ganti-segera
ADMIN_NAME=Admin Tick-IT
SEED_DEMO=0                         # 1 = isi user & tiket contoh (hanya untuk uji coba)

# ---- SSO Voyage (fleet app — satu akun Voyage berlaku di semua app anggota) ----
# Sudah di-set di Coolify (lihat coolify-deploy-summary.txt) — tidak perlu diisi ulang di produksi,
# cukup dikenali. TICKIT_VOYAGE_SERVICE_KEY itu RAHASIA, jangan taruh nilainya di sini — hanya ada
# di Coolify env vars. TICKIT_SSO_PREFIX & TICKIT_BASE_PATH dipakai DUA tempat: sso.js (next= yg
# dikirim ke Voyage) dan server.js (prefiks redirect/fetch/link app sendiri — fix Farhan #551f731,
# wajib krn Traefik memotong prefiks sebelum diteruskan ke container). TICKIT_BASE_PATH menang
# kalau dua-duanya di-set; kosong = jalan di root (dev lokal).
VOYAGE_WHOAMI_URL=http://coolify-proxy/api/v1/whoami   # panggilan internal, bukan lewat internet
VOYAGE_WHOAMI_HOST=voyage.samudracommerce.com           # Host header override utk routing Traefik
VOYAGE_PUBLIC_BASE_URL=https://voyage.samudracommerce.com
TICKIT_SSO_PREFIX=/tick-it                              # path TickIT di bawah domain Voyage
TICKIT_BASE_PATH=                                       # opsional, override TICKIT_SSO_PREFIX kalau perlu beda
TICKIT_VOYAGE_SERVICE_KEY=                              # rahasia — isi di Coolify, JANGAN commit nilainya

# ---- Integrasi Lark (opsional — kosongkan salah satu/semua utk matikan bagiannya) ----
# Notif ke grup IT: butuh LARK_WEBHOOK_URL saja.
LARK_WEBHOOK_URL=                   # Custom Bot webhook URL dari grup IT Lark (Group Settings > Bots > Add Bot > Custom Bot)
LARK_WEBHOOK_SECRET=                # isi HANYA kalau "Signature Verification" bot itu diaktifkan
# DM personal ke assignee & pembuat tiket: butuh app custom Lark (Developer Console), BUKAN webhook di atas.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_API_BASE=https://open.larksuite.com   # ganti ke https://open.feishu.cn kalau tenant-nya Feishu (domestik CN)
TICKIT_PUBLIC_URL=https://voyage.samudracommerce.com/Tick-IT   # dipakai bikin link di pesan Lark
