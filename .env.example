# Salin ke .env untuk lokal, atau isi di Coolify → Environment Variables
NODE_ENV=production
PORT=3000
DATA_DIR=/data                      # persistent storage (mount volume di Coolify)
SESSION_SECRET=ganti-dengan-string-acak-panjang
SESSION_TTL_HOURS=24
ADMIN_EMAIL=it.admin@samudraretail.co.id   # admin pertama (dibuat sekali saat DB kosong)
ADMIN_PASSWORD=ganti-segera
ADMIN_NAME=Admin Tick-IT
SEED_DEMO=0                         # 1 = isi user & tiket contoh (hanya untuk uji coba)
