# Salin ke .env untuk lokal, atau isi di Coolify → Environment Variables
NODE_ENV=development                # file ini utk LOKAL. Produksi: Dockerfile & Coolify memakai production
PORT=3000
DATA_DIR=/data                      # persistent storage (mount volume di Coolify)
SESSION_SECRET=ganti-dengan-string-acak-panjang
SESSION_TTL_HOURS=24
ADMIN_EMAIL=it.admin@samudraretail.co.id   # admin pertama (dibuat sekali saat DB kosong)
ADMIN_PASSWORD=ganti-segera
ADMIN_NAME=Admin Tick-IT
SEED_DEMO=0                         # 1 = isi user & tiket contoh (hanya untuk uji coba)

# ---- SSO Voyage (fleet app — satu akun Voyage berlaku di semua app anggota) ----
# SEMUA baris di bawah SENGAJA dikomentari. Default-nya sudah mengikuti NODE_ENV (lihat src/sso.js):
#   development -> Voyage LOKAL (http://localhost:8000, docker compose Voyage), TickIT di root "/"
#   production  -> Voyage produksi, TickIT di /tick-it, whoami lewat jaringan internal Coolify
# Jangan buka komentarnya dengan nilai produksi di .env lokal — itu yang dulu bikin TickIT lokal
# diam-diam melempar orang ke login Voyage PRODUKSI. Di produksi, nilai-nilai ini diisi di Coolify.
#
# VOYAGE_PUBLIC_BASE_URL=http://localhost:8000        # alamat Voyage yang dibuka BROWSER
# VOYAGE_WHOAMI_URL=http://host.docker.internal:8000/api/v1/whoami   # dipanggil SERVER TickIT
# VOYAGE_WHOAMI_HOST=                                 # override Host (produksi saja); kosong = tidak
# TICKIT_BASE_PATH=                                   # sub-path TickIT; lokal kosong, produksi /tick-it
#
# SATU-SATUNYA yang wajib diisi utk SSO lokal: kunci API Voyage LOKAL (settings.api_key di database
# Voyage lokal — BUKAN kunci produksi). Kosong = SSO lokal mati, masuk lewat /login email+password.
TICKIT_VOYAGE_SERVICE_KEY=
# Nama divisi Voyage yang dihitung sebagai tim IT (bisa di-assign). Bawaan: IT
# TICKIT_IT_DIVISION=IT

# ---- Integrasi Lark (opsional — kosongkan salah satu/semua utk matikan bagiannya) ----
# Notif ke grup IT: butuh LARK_WEBHOOK_URL saja.
LARK_WEBHOOK_URL=                   # Custom Bot webhook URL dari grup IT Lark (Group Settings > Bots > Add Bot > Custom Bot)
LARK_WEBHOOK_SECRET=                # isi HANYA kalau "Signature Verification" bot itu diaktifkan
# DM personal ke assignee & pembuat tiket: butuh app custom Lark (Developer Console), BUKAN webhook di atas.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_API_BASE=https://open.larksuite.com   # ganti ke https://open.feishu.cn kalau tenant-nya Feishu (domestik CN)
TICKIT_PUBLIC_URL=https://voyage.samudracommerce.com/tick-it   # dipakai bikin link di pesan Lark
